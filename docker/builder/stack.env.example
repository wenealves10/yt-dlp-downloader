# ============================================================================
# AdVideo — variáveis da produção. UM arquivo só, usado nos dois momentos:
#
#   1. build  — docker/builder/build-images.sh lê daqui e falha ANTES de buildar
#               se faltar alguma obrigatória;
#   2. deploy — este mesmo arquivo é importado na tela "Environment variables"
#               do Portainer ("Load variables from .env file").
#
# Copie e preencha:
#   cp docker/builder/stack.env.example docker/builder/stack.env
#   chmod 600 docker/builder/stack.env
#
# REGRA DAS SENHAS: só hexadecimal (`openssl rand -hex 24`). A senha do Postgres
# entra dentro de uma URL (postgres://usuario:SENHA@host/banco) e um `@`, `:`,
# `/` ou `#` no meio quebra a URL sem nenhuma mensagem que diga isso — o erro
# que aparece é "authentication failed", que manda procurar no lugar errado.
# ============================================================================

# --- Identidade do deploy ---------------------------------------------------
# As imagens são :latest e ficam locais (não há registry). É este número que faz
# o Swarm RECRIAR os containers depois de um rebuild: sem mudá-lo, "Update the
# stack" olha para a mesma tag, conclui que nada mudou e mantém o código velho
# no ar. INCREMENTE A CADA DEPLOY.
DEPLOY_REVISION=1

# --- Domínios ---------------------------------------------------------------
# Sem https:// e sem barra no fim. Saem nas regras do Traefik.
#
# ATENÇÃO: APP_DOMAIN e API_DOMAIN entram no BUNDLE do front, não só na stack.
# Trocar qualquer um dos dois exige `build-images.sh app` — atualizar a stack
# sozinho não muda o JavaScript que já foi gerado.
APP_DOMAIN=app.advideo.click
API_DOMAIN=api.advideo.click
# Host público do bucket R2, de onde o navegador carrega miniaturas e avatares.
BUCKET_HOST=https://yt-storage.wene.com.br

# --- Postgres (dentro da stack) ---------------------------------------------
# Para apontar para um banco externo (Supabase, por exemplo), preencha
# EXTERNAL_DB_SOURCE mais abaixo e remova o serviço postgres do docswarm.yaml.
POSTGRES_USER=advideo
POSTGRES_DB=advideo
# openssl rand -hex 24
POSTGRES_PASSWORD=

# Banco externo (Supabase, por exemplo). Preencher aqui NÃO basta: a
# interpolação do Compose não é recursiva, então o manifesto não consegue
# escolher entre duas URLs sozinho. Troque também, no docswarm.yaml, as duas
# linhas marcadas com "Banco externo" por "${EXTERNAL_DB_SOURCE}" e remova o
# serviço postgres-advideo. Deixe vazio para usar o Postgres da stack.
EXTERNAL_DB_SOURCE=

# --- Redis (dentro da stack) ------------------------------------------------
# openssl rand -hex 24
REDIS_PASSWORD=

# --- Token de sessão --------------------------------------------------------
# EXATAMENTE 32 caracteres: é a chave simétrica do PASETO v2.local.
# Gere com: openssl rand -hex 16
TOKEN_PASETO_KEY=
ACCESS_TOKEN_DURATION=720h

# --- Cloudflare R2 ----------------------------------------------------------
ACCOUNT_ID=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
REGION=auto
BUCKET_NAME=
ENDPOINT_URL=

# --- Cloudflare Turnstile ---------------------------------------------------
# O secret é do servidor; a site key vai no bundle do front.
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=

# --- Navegador remoto (contas do YouTube) -----------------------------------
# O MESMO valor é lido pela API, pelo worker e pelo serviço de navegador.
# Gere com: openssl rand -hex 32
BROWSER_SERVICE_TOKEN=
BROWSER_SCREEN_SIZE=1440x900
BROWSER_IDLE_TIMEOUT=15m
BROWSER_MAX_SESSIONS=2
# O Swarm ignora `security_opt`, então não há como entregar o perfil seccomp que
# libera user namespaces. Manter o sandbox exigiria CAP_SYS_ADMIN, que é bem
# pior para o host do que desligá-lo dentro de um container de propósito único.
BROWSER_DISABLE_SANDBOX=true

# Promove este e-mail a super admin no start da API. O usuário precisa já estar
# cadastrado; deixe vazio depois do primeiro deploy.
SUPER_ADMIN_EMAIL=

# --- Downloader -------------------------------------------------------------
# Arquivo de cookies estático, usado só quando NÃO há conta gerenciada
# autenticada. Com o painel de contas em uso, pode ficar vazio.
YOUTUBE_DL_FILE_COOKIES=
# Valores com espaço ou parêntese PRECISAM de aspas: o build-images.sh carrega
# este arquivo com `.` (source do shell), e um parêntese solto vira erro de
# sintaxe. O Portainer remove as aspas ao importar, então elas não vazam para
# dentro da variável.
YOUTUBE_DL_USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36"
YOUTUBE_DL_REFERER="https://www.youtube.com/"

# Proxy de saída do yt-dlp e do navegador remoto. Vazio desliga.
PROXY_ENABLED=false
PROXY_URL=

# Proxy usado SÓ para extrair metadados das plataformas que recusam IP de
# datacenter (Reddit, X, Pinterest, Instagram, Facebook, TikTok, Vimeo).
#
# Os bytes do vídeo NUNCA passam por ele. A separação existe por causa da conta:
# proxy residencial é vendido por volume, e a extração custa dezenas de KB
# enquanto o vídeo custa dezenas de MB. Roteando tudo, 1 GB de cota dá cerca de
# cem vídeos; roteando só a extração, dá dezenas de milhares.
#
# Independe de PROXY_ENABLED: são decisões separadas.
RESOLVE_PROXY_URL=

# Limites por plano, em bytes. 500MB e 5GB.
LIMIT_DOWNLOAD_FREE=524288000
LIMIT_DOWNLOAD_PREMIUM=5368709120
