# Configuração usada pelo `make dev`. Este é o arquivo de referência para a
# API, o worker, PostgreSQL e Redis no Compose.
ENV=development

# Redis (nome e porta internos da rede Docker)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=redis_dev_password

# AWS S3 configuration
ACCOUNT_ID=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
REGION=
BUCKET_NAME=
ENDPOINT_URL=

# PostgreSQL (nome e porta internos da rede Docker)
DB_HOST=postgres
DB_PORT=5432
DB_USER=yt_dlp
DB_PASSWORD=yt_dlp_dev_password
DB_NAME=yt_dlp
DB_DRIVER=postgres
DB_SOURCE=postgres://yt_dlp:yt_dlp_dev_password@postgres:5432/yt_dlp?sslmode=disable

# Proxy configuration
PROXY_ENABLED=false
PROXY_URL=

# Turnstile configuration
TURNSTILE_SECRET=

# YouTube-DL configuration
YOUTUBE_DL_FILE_COOKIES=""
YOUTUBE_DL_USER_AGENT=""
YOUTUBE_DL_REFERER=""
YOUTUBE_DL_ADD_HEADER=""
