# Configuração usada pelo `make dev`. Este é o arquivo de referência para a
# API, o worker, PostgreSQL e Redis no Compose.
ENV=development

# Redis (nome e porta internos da rede Docker)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=redis_dev_password

# AWS S3 configuration
ACCOUNT_ID=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
REGION=
BUCKET_NAME=
ENDPOINT_URL=

# PostgreSQL (nome e porta internos da rede Docker)
DB_HOST=postgres
DB_PORT=5432
DB_USER=yt_dlp
DB_PASSWORD=yt_dlp_dev_password
DB_NAME=yt_dlp
DB_DRIVER=postgres
DB_SOURCE=postgres://yt_dlp:yt_dlp_dev_password@postgres:5432/yt_dlp?sslmode=disable

# Proxy configuration
PROXY_ENABLED=false
PROXY_URL=

# Proxy usado SÓ para extrair metadados das plataformas que recusam IP de
# datacenter (Reddit, X, Pinterest, Instagram, Facebook, TikTok, Vimeo).
#
# Os bytes do vídeo NUNCA passam por ele. A separação existe por causa da conta:
# proxy residencial é vendido por volume, e a extração custa dezenas de KB
# enquanto o vídeo custa dezenas de MB. Roteando tudo, 1 GB de cota dá cerca de
# cem vídeos; roteando só a extração, dá dezenas de milhares.
#
# Independe de PROXY_ENABLED: são decisões separadas.
RESOLVE_PROXY_URL=

# Turnstile configuration
TURNSTILE_SECRET=

# YouTube-DL configuration
YOUTUBE_DL_FILE_COOKIES=""
YOUTUBE_DL_USER_AGENT=""
YOUTUBE_DL_REFERER=""
YOUTUBE_DL_ADD_HEADER=""

# Serviço de navegador remoto (advideo-browser).
# BROWSER_SERVICE_URL só é resolvível na rede interna do Docker.
# BROWSER_SERVICE_TOKEN é o segredo compartilhado entre API, worker e o serviço:
# gere um valor aleatório longo, por exemplo `openssl rand -hex 32`.
BROWSER_SERVICE_URL=http://browser:9223
BROWSER_SERVICE_TOKEN=
BROWSER_SERVICE_TIMEOUT=3m

# Promove este e-mail a super admin no start da API. O usuário precisa existir.
SUPER_ADMIN_EMAIL=

# Ajustes usados apenas pelo container do navegador.
BROWSER_LISTEN_ADDRESS=0.0.0.0:9223
BROWSER_PROFILES_DIR=/data/profiles
BROWSER_BINARY=/usr/bin/google-chrome-stable
BROWSER_SCREEN_SIZE=1440x900
BROWSER_IDLE_TIMEOUT=15m
BROWSER_MAX_SESSIONS=2
# O sandbox do Chrome depende de user namespaces, bloqueados pelo seccomp
# padrão do Docker. Com Compose, mantenha false e use o perfil
# api/docker/chrome-seccomp.json (já configurado em compose.dev.yaml). No Swarm,
# que ignora security_opt, use true.
BROWSER_DISABLE_SANDBOX=false

# Mecanismo de download multiplataforma.
# Vazio usa o binário do PATH; a versão do yt-dlp é fixada no Dockerfile.
YTDLP_BINARY=
FFMPEG_BINARY=
# A resolução roda dentro da requisição HTTP; o download, no worker.
MEDIA_METADATA_TIMEOUT=45s
MEDIA_DOWNLOAD_TIMEOUT=2h
# Diretório de trabalho dos downloads em andamento. Precisa ter espaço para o
# maior arquivo permitido pelos planos.
MEDIA_WORK_DIR=./uploads/tmp

# ---------------------------------------------------------------------------
# Integrações (a API que outros sistemas consomem)
# ---------------------------------------------------------------------------

# URL pública desta API. Usada para montar os links que vão no corpo do webhook
# ("onde buscar o arquivo deste download").
#
# Não é derivável da requisição: o evento é montado pelo despachante, fora de
# qualquer requisição HTTP, e atrás de proxy o Host que o processo vê não é o
# que o cliente usa. Vazio apenas omite os links do payload.
PUBLIC_API_URL=http://localhost:8081

# Teto por tentativa de entrega de webhook.
WEBHOOK_TIMEOUT=20s

# Espaçamento mínimo entre dois eventos de progresso do MESMO download. O
# worker publica progresso várias vezes por segundo; repassar tudo inundaria o
# servidor do cliente.
WEBHOOK_PROGRESS_INTERVAL=5s

# Permite cadastrar webhook para localhost e redes privadas.
#
# SOMENTE EM DESENVOLVIMENTO. Em produção isto transforma o campo de URL do
# painel em uma sonda da rede interna (SSRF): bastaria cadastrar
# http://169.254.169.254/ para o servidor buscar os metadados da instância.
WEBHOOK_ALLOW_PRIVATE=true

# Por quantos dias a auditoria de requisições e as entregas concluídas são
# mantidas. As entregas que FALHARAM sobrevivem três vezes mais tempo, porque é
# nelas que alguém vai procurar o motivo.
INTEGRATION_LOG_RETENTION_DAYS=30

# Publica a documentação da API em /docs e a especificação em /openapi.yaml.
# Sem autenticação de propósito: não há segredo ali, e exigir credencial para
# ler a documentação significaria precisar da chave antes de avaliar se dá para
# integrar.
DOCS_ENABLED=true
